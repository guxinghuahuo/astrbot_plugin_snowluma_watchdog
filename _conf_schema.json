{
  "enabled": {
    "type": "bool",
    "description": "启用 SnowLuma 监控",
    "default": false
  },
  "onebot_base_url": {
    "type": "string",
    "description": "SnowLuma OneBot HTTP 地址",
    "hint": "填写 AstrBot 可访问的 OneBot 基础地址，包含自定义路径（如有）。",
    "default": "http://127.0.0.1:3000"
  },
  "onebot_access_token": {
    "type": "string",
    "description": "OneBot HTTP Access Token",
    "hint": "填写所监控账号在 SnowLuma 中 HTTP 服务的 Access Token。",
    "secret": true,
    "default": ""
  },
  "expected_qq": {
    "type": "string",
    "description": "预期 QQ 号（可选）",
    "hint": "推荐填写实际要监控的 QQ 号，特别是存在多个账号配置时。",
    "default": ""
  },
  "interval_seconds": {
    "type": "int",
    "description": "探测间隔（秒）",
    "default": 30
  },
  "request_timeout_seconds": {
    "type": "int",
    "description": "单轮探测超时（秒）",
    "default": 5
  },
  "startup_grace_seconds": {
    "type": "int",
    "description": "启动或重载宽限期（秒）",
    "default": 60
  },
  "failure_threshold": {
    "type": "int",
    "description": "确认 QQ 离线或 OneBot HTTP 不可达所需的同类连续失败次数",
    "default": 2
  },
  "recovery_threshold": {
    "type": "int",
    "description": "确认恢复所需的连续在线次数",
    "default": 2
  },
  "notify_recovery": {
    "type": "bool",
    "description": "发送恢复邮件",
    "default": true
  },
  "smtp_host": {
    "type": "string",
    "description": "SMTP 服务器",
    "default": ""
  },
  "smtp_port": {
    "type": "int",
    "description": "SMTP 端口",
    "hint": "通常 SSL 使用 465，STARTTLS 使用 587。以发件邮箱服务商提供的端口为准。",
    "default": 465
  },
  "smtp_security": {
    "type": "string",
    "description": "SMTP 加密方式",
    "options": ["ssl", "starttls"],
    "default": "ssl"
  },
  "smtp_sender": {
    "type": "string",
    "description": "发件邮箱（也用作 SMTP 登录账号）",
    "default": ""
  },
  "smtp_password": {
    "type": "string",
    "description": "SMTP 授权码或应用密码",
    "secret": true,
    "default": ""
  },
  "smtp_recipient": {
    "type": "string",
    "description": "接收告警的备用邮箱",
    "default": ""
  }
}
